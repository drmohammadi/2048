# Frontend environment variables.
#
# 1. After deploying the contract with Foundry, put its address here.
#    To deploy on Base Sepolia:
#      cd contracts && forge script script/Deploy.s.sol:DeployGame2048 \
#        --rpc-url $BASE_SEPOLIA_RPC_URL --broadcast --verify
#
# 2. Copy this file to .env (it is git-ignored) and fill in the values.

# Contract address on Base (mainnet), e.g. 0x1234...abcd
VITE_CONTRACT_ADDRESS_BASE=0x0000000000000000000000000000000000000000

# Contract address on Base Sepolia testnet
VITE_CONTRACT_ADDRESS_BASE_SEPOLIA=0x0000000000000000000000000000000000000000

# Which chain the app loads with: "base" or "base-sepolia"
VITE_DEFAULT_CHAIN=base-sepolia

# Optional: override the public RPC endpoints (defaults to the public Base RPCs).
# VITE_RPC_URL_BASE=https://mainnet.base.org
# VITE_RPC_URL_BASE_SEPOLIA=https://sepolia.base.org
